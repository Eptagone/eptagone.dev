---
import Layout from "@layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@shared/constants";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="flex">
        <div class="m-auto w-full max-w-6xl p-6">
            <h1 class="mb-2 text-4xl">Hello world!</h1>
            <p>This is my personal website and as you see, there're not much here yet but feel free to explore anyway.</p>
            <p>
                If you are interested, you can explore my <a href="/blog" class="underline">blog</a> or one of my <a href="/projects" class="underline">projects</a>. Maybe you'll find something interesting here.
            </p>
        </div>
    </div>
</Layout>
