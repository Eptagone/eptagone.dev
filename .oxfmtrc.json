{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [],
  "endOfLine": "lf",
  "semi": true,
  "tabWidth": 4,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "jsdoc": true,
  "overrides": [
    {
      "files": ["*.json", "*.yaml", "*.yml"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["astro.config.ts"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
